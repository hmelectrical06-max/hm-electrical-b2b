# Copy to .env and fill in values locally. Never commit .env.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side Supabase secret key or legacy service_role JWT; never expose in browser code.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_USER_IDS=
SITE_ORIGIN=http://localhost:8888
RATE_LIMIT_SECRET=

# Server-side Resend settings for enquiry and service-booking email notifications.
# EMAIL_FROM must use a sender domain verified in Resend. Messages go to public/company.json.
HM_EMAIL_PROVIDER_TOKEN=
EMAIL_FROM=

# Build mode stays staging until the protected site is tested.
HM_SITE_MODE=staging
# Netlify staging only: set true AFTER visitor access protection is enabled.
HM_PRIVATE_TESTING_ACK=
# Production context only, after explicit launch authorization:
HM_LAUNCH_APPROVED=

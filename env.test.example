# Copy this file to .env.test. Keep .env.test local and never share its contents.
# Get all Supabase values from the separate HM ELECTRICAL TEST project only.
HM_TEST_SUPABASE_PROJECT_REF=replace_with_test_project_ref
SUPABASE_URL=https://replace_with_test_project_ref.supabase.co
SUPABASE_ANON_KEY=replace_with_test_project_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_test_project_service_role_key
# Create an admin user in the TEST project's Supabase Auth; put that user's UUID here.
ADMIN_USER_IDS=replace_with_test_admin_user_uuid
SITE_ORIGIN=http://localhost:8888
# Generate a local-only random value of at least 32 characters.
RATE_LIMIT_SECRET=replace_with_a_local_random_value_at_least_32_characters
# Keep email disabled during staging tests.
RESEND_API_KEY=
EMAIL_FROM=
